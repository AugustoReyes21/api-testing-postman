      "get": {
        "operationId": "listOwnOrders",
        "summary": "Listar solamente pedidos propios",
        "description": "Orden ascendente por id. page comienza en 1; limit máximo 50. Una página fuera del rango devuelve data vacío y conserva los metadatos. totalPages es 0 si no hay pedidos. Parámetros desconocidos o repetidos se rechazan con 400.",
        "tags": [
          "Pedidos"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Página sin ceros iniciales.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Tamaño de página sin ceros iniciales.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          }

    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Crear pedido propio",
        "description": "El propietario proviene de la sesión. No se aceptan campos extra. Total = suma(quantity * unitPriceCents). Moneda obligatoria GTQ o USD. No se aceptan productos vacíos ni compuestos solo por espacios.",

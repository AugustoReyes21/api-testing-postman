                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Location": {
                "description": "Ruta del nuevo pedido.",
                "schema": {
                  "type": "string",
                  "pattern": "^/orders/[1-9][0-9]*$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {

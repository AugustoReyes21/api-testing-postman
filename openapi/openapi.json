{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "API académica de pedidos",
    "version": "1.0.0",
    "description": "Práctica local con usuarios ficticios. Los importes son centavos enteros. Los pedidos solo son accesibles por su propietario. Las contraseñas no se guardan en texto plano; los tokens opacos expiran en una hora. No es un servicio de producción."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Servidor local de la práctica"
    }
  ],
  "tags": [
    {
      "name": "Diagnóstico",
      "description": "Estado del servidor"
    },
    {
      "name": "Autenticación",
      "description": "Sesiones ficticias"
    },
    {
      "name": "Pedidos",
      "description": "Recursos de cada propietario"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Comprobar disponibilidad",
        "tags": [
          "Diagnóstico"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Servidor funcionando.",
            "headers": {
              "X-Request-Id": {
                "description": "UUID de correlación; no contiene credenciales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "description": "Se evita almacenar respuestas con datos de sesión o pedidos.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Error interno sin detalles de implementación.",
            "headers": {
              "X-Request-Id": {
                "description": "UUID de correlación; no contiene credenciales.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "description": "Se evita almacenar respuestas con datos de sesión o pedidos.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
